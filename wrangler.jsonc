{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smm-api-center",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smm-api-center-db",
      "database_id": "4e4161fc-34a7-42f6-b6a9-ff311b040bf8"
    }
  ],
  "services": [
    {
      "binding": "AMARSMM",
      "service": "uglypay"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ADMIN_PASSWORD": "tamim121"
  }
}
