{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegrow",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serves public/index.html, public/admin/index.html and public/assets/*.
  // The Worker's fetch handler intercepts /api/* before assets are checked.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegrow-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "vars": {
    "ENV": "production"
  }
}

