{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smm-api-center",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smm-api-center-db",
      "database_id": "10e0d47e-07c5-4478-ab3a-f6e8ce070c77"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ADMIN_PASSWORD": "tamim121"
  }
}
