{
"$schema": "node_modules/wrangler/config-schema.json",
"name": "telegrow",
"main": "worker.js",
"compatibility_date": "2025-01-01",
"compatibility_flags": ["nodejs_compat"],

// Serves index.html, /admin/index.html and everything in /assets as static files.
// The Worker's fetch handler intercepts /api/* before assets are checked.
"assets": {
"directory": "./",
"binding": "ASSETS",
"not_found_handling": "single-page-application"
},

"d1_databases": [
{
"binding": "DB",
"database_name": "telegrow-db",
"database_id": "3f2bc813-08f4-424f-8e7d-c8793ca1a23d"
}
],

// Non-secret vars can stay here. For BOT_TOKEN / ADMIN_PASSWORD in production,
// prefer: wrangler secret put BOT_TOKEN  /  wrangler secret put ADMIN_PASSWORD
"vars": {
"ENV": "production"
}
}
