{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegrow",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serves public/index.html, public/admin/index.html and public/assets/*.
  // The Worker's fetch handler intercepts /api/* before assets are checked.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegrow-db",
      "database_id": "e6d92328-ed42-41cb-9a3a-ff35dfa031a5"
    }
  ],

  // Cron Trigger: every 1 minute — the fastest granularity Cloudflare Cron
  // Triggers support — syncs Processing orders + pending refills from the provider.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "vars": {
    "ENV": "production",
    // Set this to your deployed Worker URL (e.g. https://yourapp.yoursubdomain.workers.dev)
    // so the order-log button can link back to the Mini App.
    "APP_URL": "https://REPLACE_WITH_YOUR_WORKER_URL"
  }
}

